# Copy this file to .env and change values if needed
PORT=5000

# Which websites may call this API (comma separated).
# Leave empty to allow http://localhost:<any port> (good for development).
# Production example: CORS_ORIGIN=https://stockpro.yourcompany.com
CORS_ORIGIN=

# Where the database file is stored
DATA_DIR=./data

# sqlite (default) or json (fallback, no SQLite needed)
STORE=sqlite